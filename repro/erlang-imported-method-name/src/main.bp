mod shapes;

import {of} from "shapes";

// CONTROL — the SAME collision, declared LOCALLY. Green on erlang: a second
// local type claiming `name/arity` clears the entry (`putMethodOwner`), so the
// name never decides on its own.
pub type Bag<T>(
    items: Array<T>,
) {
    pub fn unwrap(self: Self) -> Array<T> {
        return self.items;
    }
}

pub type Bucket<K, V>(
    key: K,
    items: Array<V>,
) {
    pub fn unwrap(self: Self) -> Array<V> {
        return self.items;
    }
}

test "a local method name shared by two records still dispatches on the receiver" {
    assert Bag(items: [1, 2, 3]).unwrap().length == 3;
}

// THE DEFECT — across a module boundary the same shape resolves by NAME:
//
//     shapes__t__grouping:toArray(shapes:'of'([1, 2, 3]))
//
// a `Grouping` function reading `element(3, …)` applied to a `Query` tuple of
// size 2, which is `{error, badarg}`. commonJS is green.
test "across a module boundary a Query keeps its own toArray" {
    assert of([1, 2, 3]).toArray().length == 3;
}
