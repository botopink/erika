import query from "query";

type City(name: string, pop: i32)

type Owner(owner: string, city: string)

val cities = [City(name: "Lyon", pop: 5)];

val owners = [Owner(owner: "ana", city: "Lyon")];

fn main() {
    val r = query "select owner from owners join cities on owners.city = cities.name";
    @print(r);
}
