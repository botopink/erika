//// erika — a C#/LINQ-style query library, pure botopink over `Array<T>`.
////
//// A `type Query<T>` wraps an `Array<T>` (`items`) and exposes a fluent
//// operator vocabulary (`where`/`select`/`orderBy`/`groupBy`/`aggregate`/…).
//// Eager + immutable: every operator returns a *new* `Query<U>` over a freshly
//// materialized array (like `sets.bp`). Terminals return scalars, `?T`, or
//// `Array<T>`. No host backing — built on the `Array<T>` interface.
////
//// API naming notes:
////   - Constructors are top-level `pub fn` (`of`/`range`/`repeat`/`empty`).
////     `from` is the `import` keyword and cannot name a function, so the wrapper
////     constructor is `of` (the `Pair.of` shape) — locked across the API and the
////     `erika "…"` expansion.
////   - Methods are camelCase (`orderByDescending`, not Pascal).
////   - There is no arity-based overloading (on commonJS the later of two
////     same-named methods replaces the earlier), so the predicate variants are
////     spelled out: `count`/`countWhere`,
////     `first`/`firstWhere`, `any`/`anyWhere`.
////   - `cast`/`ofType` are omitted: there are no runtime type tags to dispatch on.

pub type Query<T>(
    items: Array<T>,
) {
    // ── materializers / size ──────────────────────────────────────────────────
    pub fn toArray(self: Self<T>) -> Array<T> {
        return self.items;
    }

    pub fn toList(self: Self<T>) -> Array<T> {
        return self.items;
    }

    pub fn count(self: Self<T>) -> i32 {
        return self.items.length;
    }

    pub fn isEmpty(self: Self<T>) -> bool {
        return self.items.length == 0;
    }

    // ── F1: restriction / projection ──────────────────────────────────────────
    pub fn where(self: Self<T>, pred: fn(item: T) -> bool) -> Query<T> {
        return Query(items: self.items.filter(pred));
    }

    pub fn select<U>(self: Self<T>, selector: fn(item: T) -> U) -> Query<U> {
        return Query(items: self.items.map(selector));
    }

    // `selectMany` (flatMap): the per-item selector returns an `Array<U>` and the
    // results are concatenated into one flat `Query<U>`. Unblocked by `fn() -> T[]`
    // in a function-type parameter (v0.beta.6 gap G3, landed in `feat`).
    pub fn selectMany<U>(
        self: Self<T>,
        selector: fn(item: T) -> Array<U>,
    ) -> Query<U> {
        var out: Array<U> = [];
        self.items.forEach({ x ->
            out = out.append(selector(x));
        });
        return Query(items: out);
    }

    // ── F2: partitioning / ordering ───────────────────────────────────────────
    pub fn take(self: Self<T>, n: i32) -> Query<T> {
        return Query(items: self.items.take(n));
    }

    pub fn skip(self: Self<T>, n: i32) -> Query<T> {
        return Query(items: self.items.drop(n));
    }

    pub fn takeWhile(self: Self<T>, pred: fn(item: T) -> bool) -> Query<T> {
        var out: Array<T> = [];
        var taking = true;
        self.items.forEach({ x ->
            if (taking) if (pred(x)) out = out.append([x]) else taking = false;
        });
        return Query(items: out);
    }

    pub fn skipWhile(self: Self<T>, pred: fn(item: T) -> bool) -> Query<T> {
        var out: Array<T> = [];
        var skipping = true;
        self.items.forEach({ x ->
            if (skipping) {
                val stop = !pred(x);
                if (stop) {
                    skipping = false;
                    out = out.append([x]);
                }
            } else out = out.append([x]);
        });
        return Query(items: out);
    }

    pub fn reverse(self: Self<T>) -> Query<T> {
        return Query(items: self.items.reverse());
    }

    // Stable ascending sort by a projected comparable key (insertion by `<`).
    pub fn orderBy<K>(self: Self<T>, keyFn: fn(item: T) -> K) -> Query<T> {
        var sorted: Array<T> = [];
        self.items.forEach({ x ->
            val kx = keyFn(x);
            val before = sorted.filter({ y -> !(kx < keyFn(y)) });
            val after = sorted.filter({ y -> kx < keyFn(y) });
            sorted = before.append([x]).append(after);
        });
        return Query(items: sorted);
    }

    pub fn orderByDescending<K>(
        self: Self<T>,
        keyFn: fn(item: T) -> K,
    ) -> Query<T> {
        var sorted: Array<T> = [];
        self.items.forEach({ x ->
            val kx = keyFn(x);
            val before = sorted.filter({ y -> !(keyFn(y) < kx) });
            val after = sorted.filter({ y -> keyFn(y) < kx });
            sorted = before.append([x]).append(after);
        });
        return Query(items: sorted);
    }

    // ── F3: set ops / grouping / joining ──────────────────────────────────────
    pub fn distinct(self: Self<T>) -> Query<T> {
        var out: Array<T> = [];
        self.items.forEach({ x ->
            val fresh = out.indexOf(x) == -1;
            if (fresh) out = out.append([x]);
        });
        return Query(items: out);
    }

    pub fn distinctBy<K>(self: Self<T>, keyFn: fn(item: T) -> K) -> Query<T> {
        var out: Array<T> = [];
        var keys: Array<K> = [];
        self.items.forEach({ x ->
            val k = keyFn(x);
            val fresh = keys.indexOf(k) == -1;
            if (fresh) {
                keys = keys.append([k]);
                out = out.append([x]);
            }
        });
        return Query(items: out);
    }

    pub fn concat(self: Self<T>, other: Query<T>) -> Query<T> {
        return Query(items: self.items.append(other.items));
    }

    pub fn union(self: Self<T>, other: Query<T>) -> Query<T> {
        return self.concat(other).distinct();
    }

    pub fn intersect(self: Self<T>, other: Query<T>) -> Query<T> {
        val kept = self.items.filter({ x -> other.items.indexOf(x) != -1 });
        return Query(items: kept).distinct();
    }

    pub fn except(self: Self<T>, other: Query<T>) -> Query<T> {
        val kept = self.items.filter({ x -> other.items.indexOf(x) == -1 });
        return Query(items: kept).distinct();
    }

    pub fn groupBy<K>(
        self: Self<T>,
        keyFn: fn(item: T) -> K,
    ) -> Query<Grouping<K, T>> {
        var keys: Array<K> = [];
        self.items.forEach({ x ->
            val k = keyFn(x);
            val fresh = keys.indexOf(k) == -1;
            if (fresh) keys = keys.append([k]);
        });
        var groups: Array<Grouping<K, T>> = [];
        keys.forEach({ k ->
            val members = self.items.filter({ x -> keyFn(x) == k });
            groups = groups.append([Grouping(key: k, items: members)]);
        });
        return Query(items: groups);
    }

    // Pairs each element with the element at the same index in `other`, stopping
    // at the shorter length, and combines them with `combine`.
    pub fn zip<U, R>(
        self: Self<T>,
        other: Query<U>,
        combine: fn(a: T, b: U) -> R,
    ) -> Query<R> {
        val n = if (self.items.length < other.items.length)
            self.items.length
        else
            other.items.length;
        var out: Array<R> = [];
        var i = 0;
        self.items
            .take(n)
            .forEach({ a ->
                val mb = other.items.at(i);
                if (mb) {
                    b ->
                    out = out.append([combine(a, b)]);
                }
                i = i + 1;
            });
        return Query(items: out);
    }

    // ── F4: aggregation / element / quantifiers (terminals) ───────────────────
    pub fn countWhere(self: Self<T>, pred: fn(item: T) -> bool) -> i32 {
        return self.items.filter(pred).length;
    }

    pub fn sum(self: Self<T>, selector: fn(item: T) -> i32) -> i32 {
        return self.items.fold(0, { acc, x -> acc + selector(x) });
    }

    pub fn average(self: Self<T>, selector: fn(item: T) -> f64) -> f64 {
        var total = 0.0;
        var n = 0.0;
        self.items.forEach({ x ->
            total = total + selector(x);
            n = n + 1.0;
        });
        if (n == 0.0) return 0.0;
        return total / n;
    }

    pub fn min<K>(self: Self<T>, keyFn: fn(item: T) -> K) -> ?K {
        val keys = self.items.map(keyFn);
        var best = keys.at(0);
        keys.forEach({ k ->
            if (best) {
                b ->
                if (k < b) best = k;
            }
        });
        return best;
    }

    pub fn max<K>(self: Self<T>, keyFn: fn(item: T) -> K) -> ?K {
        val keys = self.items.map(keyFn);
        var best = keys.at(0);
        keys.forEach({ k ->
            if (best) {
                b ->
                if (b < k) best = k;
            }
        });
        return best;
    }

    pub fn aggregate<A>(
        self: Self<T>,
        seed: A,
        step: fn(acc: A, item: T) -> A,
    ) -> A {
        return self.items.fold(seed, step);
    }

    pub fn first(self: Self<T>) -> ?T {
        return self.items.at(0);
    }

    pub fn firstWhere(self: Self<T>, pred: fn(item: T) -> bool) -> ?T {
        return self.items.filter(pred).at(0);
    }

    pub fn last(self: Self<T>) -> ?T {
        return self.items.at(self.items.length - 1);
    }

    pub fn single(self: Self<T>) -> ?T {
        if (self.items.length == 1) return self.items.at(0);
        return self.items.at(self.items.length); // absent unless exactly one
    }

    pub fn elementAt(self: Self<T>, index: i32) -> ?T {
        return self.items.at(index);
    }

    pub fn any(self: Self<T>) -> bool {
        return self.items.length != 0;
    }

    pub fn anyWhere(self: Self<T>, pred: fn(item: T) -> bool) -> bool {
        return self.items.filter(pred).length != 0;
    }

    pub fn all(self: Self<T>, pred: fn(item: T) -> bool) -> bool {
        return self.items.filter(pred).length == self.items.length;
    }

    pub fn contains(self: Self<T>, x: T) -> bool {
        return self.items.indexOf(x) != -1;
    }
}

// A keyed bucket produced by `groupBy`: the shared key plus its members.
pub type Grouping<K, V>(
    key: K,
    items: Array<V>,
) {
    pub fn count(self: Self<K, V>) -> i32 {
        return self.items.length;
    }

    pub fn toArray(self: Self<K, V>) -> Array<V> {
        return self.items;
    }
}

// ── the database target: what a persistence library implements and records ───
//
// erika names no library (113): the SQL target speaks to a `QueryContext`, which
// a persistence library implements (dbcontext's `DbContext`, 398), and reads the
// `QueryTable` meta that library records on an entity (`#[entity]`, 397 (1), the
// pattern of 383: the lower layer declares the meta).

/// One column of an entity: the field it maps from and the column it names.
pub type QueryColumn(
    field: string,
    column: string,
)

/// The table an entity maps to and its columns — the typed meta (298) a
/// persistence library records on an entity, `@typeInfo(User).meta(QueryTable)`.
pub type QueryTable(
    name: string,
    columns: Array<QueryColumn>,
)

/// Where a statement runs. `run` sends `sql` with `params` bound positionally
/// (`$1…$n`, in the order the query's holes are written, each as text) and
/// answers the rows decoded as `T`; `E` is the implementor's own error, so erika
/// names no library's.
pub behavior QueryContext<E> {
    fn run<T>(
        self: Self<E>,
        sql: string,
        params: Array<string>,
    ) -> @Result<Array<T>, E>;
}

// ── constructors ──────────────────────────────────────────────────────────────

pub fn of<T>(xs: Array<T>) -> Query<T> {
    return Query(items: xs);
}

pub fn empty<T>() -> Query<T> {
    return Query(items: []);
}

fn rangeInto(acc: Array<i32>, i: i32, stop: i32) -> Array<i32> {
    if (i >= stop) return acc;
    return rangeInto(acc.append([i]), i + 1, stop);
}

pub fn range(start: i32, stop: i32) -> Query<i32> {
    return Query(items: rangeInto([], start, stop));
}

fn repeatInto<T>(acc: Array<T>, value: T, n: i32) -> Array<T> {
    if (n <= 0) return acc;
    return repeatInto(acc.append([value]), value, n - 1);
}

pub fn repeat<T>(value: T, times: i32) -> Query<T> {
    return Query(items: repeatInto([], value, times));
}

// ── holes: a `${…}` operand is a bound value, typed against what it meets ────
//
// The template cannot see a hole's type (its body is untyped) and the checker
// does not look inside the lambdas handed to a `Query` operator, so the lowering
// ties every hole to what it is compared with OUTSIDE the pipeline: `holeTie`
// shares one `F` between a hole and the column it meets (`src.map({ row ->
// row.age })` is checked against the source's element type, so a field the type
// lacks and a hole of another type are the ordinary type errors), `holeSame` between a hole and a
// literal or another hole. the ties are `val`s ahead of the pipeline, and
// `bindOnce` binds a hole's expression to a name, so it is evaluated once, not
// once per row. They are private: the code `q.build` writes resolves in this
// module (112).

fn holeTie<F>(column: Array<F>, value: F) -> bool {
    return true;
}

fn holeSame<T>(a: T, b: T) -> bool {
    return true;
}

fn holeBound<F, R>(column: Array<F>, value: F, body: fn(held: F) -> R) -> R {
    return body(value);
}

// The aggregates of a query or of a group, as plain functions: a method call
// on a receiver whose type the checker has not fixed (inside the lambda of
// `bindOnce` / `holeBound`) is dispatched by name alone on erlang.
fn aggCount<T>(rows: Query<T>) -> i32 {
    return rows.count();
}

fn aggSum<T>(rows: Query<T>, field: fn(item: T) -> i32) -> i32 {
    return rows.sum(field);
}

fn aggAvg<T>(rows: Query<T>, field: fn(item: T) -> f64) -> f64 {
    return rows.average(field);
}

fn aggMin<T, K>(rows: Query<T>, field: fn(item: T) -> K) -> ?K {
    return rows.min(field);
}

fn aggMax<T, K>(rows: Query<T>, field: fn(item: T) -> K) -> ?K {
    return rows.max(field);
}

fn queryTake<T>(rows: Query<T>, n: i32) -> Query<T> {
    return rows.take(n);
}

fn queryFirst<T>(rows: Query<T>) -> ?T {
    return rows.first();
}

fn groupRows<K, V>(group: Grouping<K, V>) -> Query<V> {
    return Query(items: group.items);
}

fn bindOnce<H, R>(value: H, body: fn(held: H) -> R) -> R {
    return body(value);
}

// ── F5: the `erika "…"` query-string template fn ──────────────────────────────
//
// `erika` is the package's `pub default fn` — the handler the `erika "…"` DSL
// resolves to. A consumer binds it with `import erika` (the package handle →
// `pub default fn`, package-default-dsl); the handler keeps the lib's name so the
// generic-loader namespace form (`erika.of(…)`) still resolves through it. It is
// a template function: it captures a SQL-subset query string as
// `@Expr<string>`, runs a real three-stage front-end over it at comptime, and
// returns `@ExprCustom<T>` — an executable pipeline plus a reference tree the
// LSP overlays. Grammar (keywords lowercase):
//
//   select <* | f1[, f2…]> from <Name> [where <cond>] [order by <field> [asc|desc]]
//
// The front-end is, in order:
//   ① lexer   — a char-by-char scanner (`q.text()` → `Token[]`); every token
//               carries a real `Span` of byte offsets (no more `split`/`join`,
//               which destroyed positions).
//   ② parser  — buckets the tokens into a `SelectStmt`-shaped value (`star` /
//               `fields` / `srcName` / `orGroups` / `orderName`), the where
//               clause split into `or`-of-`and`-of-comparison groups so the
//               `or < and < comparison` precedence is structural.
//   ③ lower → @Expr<T>     — walks the parse into the fluent pipeline string
//               `of(Name).where({row -> …}).orderBy(…).select(…).toArray()` and
//               splices it with `q.build(...)` (behaviour identical to before:
//               single field unwraps, multi → a tuple `#(a, b)`, `*` → `toArray()`,
//               `=`→`==`, `<>`→`!=`, `and`→`&&`, `'x'`→`"x"`).
//   ④ lower → CustomNode   — walks the SAME tokens into the generic reference
//               tree (label per node: keywords → `keyword`, idents → `property`,
//               string/number lits → `string`/`number`, comparison/logical ops →
//               `operator`); the source node carries `ref` (the `q.lookup`
//               binding) for hover/go-to-def.
//
// A single field projects that column (`Array<field>`); two or more project an
// tuple `#(f1, f2)` per row, labeled by the column names (gap G2). `*` returns
// the whole rows. An unknown collection (or a malformed condition) aborts with
// `q.failAt(span, …)` ranged at the offending token, not the whole template.
//
// Comptime-eval constraint (see AGENTS.md): the body runs in the persistent
// Erlang comptime runtime, and only this template fn is lowered, so there are NO
// calls to sibling fns and NO named-type constructors — the whole front-end is
// inlined here, the private SQL "AST" is modelled with tuples (Erlang tuples,
// read positionally), and helpers are local closures. "Optional" where/order
// are 0-length-list sentinels (no `@Option` in the body); compound booleans live
// in a `val` before any `if (…)` (a parser quirk, not a runtime one).
pub default fn erika<T>(comptime q: @Expr<string>) -> @ExprCustom<T> {
    // ① Materialize the SQL source from the template's parts. A literal call
    // (`erika "select …"`) collapses to a single Text part; a holed call
    // (`erika "select … where id = ${uid}"`) yields alternating Text + Interp
    // parts. Each Interp's `code` field is the hole's placeholder identifier
    // (e.g. `__bp_hole_q_0`) — splicing it into the augmented SQL makes the
    // hole behave like an ordinary operand at lex/parse time; the lowering's
    // operandCode detects the placeholder prefix and emits it verbatim so
    // `infer.substituteHoles` swaps in the caller's expression after build().
    var sql = "";
    var holes: Array<string> = [];
    for (q.parts()) { p ->
        if (p.kind == "Text") sql = sql + p.text;
        if (p.kind == "Interp") {
            sql = sql + p.code;
            holes = holes.append([p.code]);
        }
    }
    val sqlLen = sql.split("").length;
    // Trailing space forces the final token to flush at the end of the scan
    // (bound to a `val` first — the comptime parser rejects `(expr).method()`).
    val padded = sql + " ";
    val chars = padded.split("");
    // Tokens, projected fields and comparisons are tuples read positionally: the
    // comptime evaluator runs this body untyped, where a label (`t.0`) cannot be
    // resolved to its index, so the elements are addressed by position —
    //   token      #(kind, text, span)                        → t.0 t.1 t.2
    //   field      #(name, span)                              → f.0 f.1
    //   comparison #(lKind, lText, opText, opSpan, rKind, rText, hasOp) → cmp.0 … cmp.6
    val mkTok = { kind, text, span -> #(kind, text, span) };
    val mkField = { name, span -> #(name, span) };
    val blankTok = mkTok("", "", Span(0, 0, 1));

    // ── local helpers (lowering ③) ────────────────────────────────────────────
    // A token's text starts with `__bp_hole_` exactly when it tracks a `${…}`
    // hole spliced via `q.parts()` (the prefix is reserved for template holes).
    // The lexer classifies it as an `ident`; here we emit it as a bare
    // expression in the generated pipeline so the post-build `substituteHoles` pass
    // swaps in the caller's expression with no further wrapping.
    val isHolePlaceholder = { txt ->
        val out = if (txt.split("").length < 10)
            false
        else
            txt.slice(0, 10) == "__bp_hole_";
        out;
    };

    // A comparison group's tokens → a flat comparison tuple (`left [op right]`).
    // Positional extraction counts the items in a `var` (the loop folds
    // `lTok`/`opTok`/`rTok` out); a dangling operator (2 tokens) is a `failAt` at
    // the operator.
    val buildCmp = { cmpToks ->
        var lTok = blankTok;
        var opTok = blankTok;
        var rTok = blankTok;
        var idx = 0;
        for (cmpToks) { ct ->
            if (idx == 0) lTok = ct;
            if (idx == 1) opTok = ct;
            if (idx == 2) rTok = ct;
            idx = idx + 1;
        }
        val cnt = cmpToks.length;
        if (cnt == 1)
            if (isHolePlaceholder(lTok.1))
                q.failAt(
                    lTok.2,
                    "erika: a hole is a bound value to compare, not a condition; write `field = <hole>`",
                );
        if (cnt > 3)
            q.failAt(
                cmpToks.at(3).2,
                "erika: unexpected '" + cmpToks.at(3).1 + "' in the condition",
            );
        if (cnt == 2)
            q.failAt(
                opTok.2,
                "erika: condition needs a value after '" + opTok.1 + "'",
            );
        val mkCmp = { lKind, lText, opText, opSpan, rKind, rText, hasOp, lSpan, rSpan -> #(lKind, lText, opText, opSpan, rKind, rText, hasOp, lSpan, rSpan) };
        mkCmp(
            lTok.0,
            lTok.1,
            opTok.1,
            opTok.2,
            rTok.0,
            rTok.1,
            cnt >= 3,
            lTok.2,
            rTok.2,
        );
    };


    // ── ① lexer: chars → Token[] with real spans ──────────────────────────────
    // `for (chars) { ch -> }` binds the char; `pos` counts its byte offset. Every token is
    // emitted through a SINGLE `toks.append` site (the `pending` flush): word
    // chars and operator chars (`< > = !`) accumulate into one token; whitespace,
    // commas, `*`, parens and `'…'` strings are their own boundaries; a token
    // closes when the next char no longer continues it, ending at that char's
    // offset (the trailing space flushes the last one). The single append site is
    // kept from an older type-checker limit (three-plus branchy append sites no
    // longer mis-unify); the kind is classified here, not at per-kind sites.
    var toks: Array<#(string, string, Span)> = [];
    var cur = "";
    var curKind = "";
    var curStart = 0;
    var strClosed = false;
    var pos = 0;
    for (chars) { ch ->
        val i = pos;
        pos = pos + 1;
        val isWs = ch == " " || ch == "\n" || ch == "\r" || ch == "\t";
        val isComma = ch == ",";
        val isStar = ch == "*";
        val isParen = ch == "(" || ch == ")";
        val isQuote = ch == "'";
        val isOpCh = ch == "<" || ch == ">" || ch == "=" || ch == "!";
        val isWordCh = !isWs
            && !isComma
            && !isStar
            && !isParen
            && !isQuote
            && !isOpCh;
        val contWord = curKind == "word" && isWordCh;
        val contOp = curKind == "op" && isOpCh;
        val contStr = curKind == "str" && !strClosed;
        val cont = contWord || contOp || contStr;
        if (cont) {
            cur = cur + ch;
            if (isQuote) strClosed = true;
        }
        if (!cont) {
            val pending = curKind != "";
            if (pending) {
                val c0 = cur.slice(0, 1);
                val isDigit0 = c0 == "0"
                    || c0 == "1"
                    || c0 == "2"
                    || c0 == "3"
                    || c0 == "4"
                    || c0 == "5"
                    || c0 == "6"
                    || c0 == "7"
                    || c0 == "8"
                    || c0 == "9";
                val isKwTok = cur == "select"
                    || cur == "from"
                    || cur == "where"
                    || cur == "order"
                    || cur == "by"
                    || cur == "asc"
                    || cur == "desc"
                    || cur == "and"
                    || cur == "or"
                    || cur == "join"
                    || cur == "on"
                    || cur == "group"
                    || cur == "limit";
                val isWordKind = curKind == "word";
                val wordFinal = if (isDigit0)
                    "number"
                else if (isKwTok)
                    "keyword"
                else
                    "ident";
                val nonWord = if (curKind == "str") "string" else curKind;
                val finalKind = if (isWordKind) wordFinal else nonWord;
                toks = toks.append(
                    [mkTok(finalKind, cur, Span(curStart, i, 1))],
                );
            }
            cur = ch;
            curStart = i;
            strClosed = false;
            if (isWordCh) curKind = "word";
            if (isOpCh) curKind = "op";
            if (isQuote) curKind = "str";
            if (isComma) curKind = "comma";
            if (isStar) curKind = "star";
            if (isParen) curKind = "paren";
            if (isWs) {
                curKind = "";
                cur = "";
            }
        }
    }


    // ── ② parser: bucket tokens into the SelectStmt pieces ────────────────────
    // A hole is a bound value: it may stand only as the operand of a comparison
    // (`where`) or as the number of rows (`limit`) — never as a field, a table,
    // a keyword or a piece of a string.
    var headToks: Array<#(string, string, Span)> = [];
    var srcName = "";
    var srcSpan = Span(0, 0, 1);
    var joinName = "";
    var joinSpan = Span(0, 0, 1);
    var onToks: Array<#(string, string, Span)> = [];
    var whereToks: Array<#(string, string, Span)> = [];
    var groupName = "";
    var groupSpan = Span(0, 0, 1);
    var orderToks: Array<#(string, string, Span)> = [];
    var limitToks: Array<#(string, string, Span)> = [];
    var section = "head";
    for (toks) { t ->
        val tk = t.0;
        val tx = t.1;
        val isFrom = tk == "keyword" && tx == "from";
        val isJoin = tk == "keyword" && tx == "join";
        val isOn = tk == "keyword" && tx == "on";
        val isWhere = tk == "keyword" && tx == "where";
        val isGroup = tk == "keyword" && tx == "group";
        val isOrder = tk == "keyword" && tx == "order";
        val isBy = tk == "keyword" && tx == "by";
        val isLimit = tk == "keyword" && tx == "limit";
        val isStructural = isFrom
            || isJoin
            || isOn
            || isWhere
            || isGroup
            || isOrder
            || isBy
            || isLimit;
        if (isFrom) section = "afterFrom";
        if (isJoin) section = "join";
        if (isOn) section = "on";
        if (isWhere) section = "where";
        if (isGroup) section = "group";
        if (isOrder) section = "order";
        if (isLimit) section = "limit";
        val isHoleTok = isHolePlaceholder(tx);
        val holeInStr = tk == "string" && tx.contains("__bp_hole_");
        if (holeInStr)
            q.failAt(
                t.2,
                "erika: a hole is a bound value, never text: it cannot stand inside a string literal",
            );
        val holeOk = section == "where" || section == "limit";
        if (isHoleTok)
            if (!holeOk)
                q.failAt(
                    t.2,
                    "erika: a hole is a bound value, never text: it cannot stand for a field or a table, only for the operand of a comparison or the number of rows",
                );
        if (!isStructural) {
            val stray = section == "tail" || section == "joinTail";
            if (stray)
                q.failAt(
                    t.2,
                    "erika: unexpected '" + tx + "' after the collection",
                );
            if (section == "head") headToks = headToks.append([t]);
            if (section == "afterFrom") {
                srcName = tx;
                srcSpan = t.2;
                section = "tail";
            }
            if (section == "join") {
                joinName = tx;
                joinSpan = t.2;
                section = "joinTail";
            }
            if (section == "on") onToks = onToks.append([t]);
            if (section == "where") whereToks = whereToks.append([t]);
            if (section == "group")
                if (groupName == "") {
                    groupName = tx;
                    groupSpan = t.2;
                }
            if (section == "order") orderToks = orderToks.append([t]);
            if (section == "limit") limitToks = limitToks.append([t]);
        }
    }

    // The select list: `*`, fields, and aggregates (`count(*)`, `sum(f)`, `avg(f)`,
    // `min(f)`, `max(f)`). An item is #(kind, name, arg, span): kind `field`
    // (name = the field) or `agg` (name = the function, arg = its field or `*`).
    var star = false;
    var items: Array<#(string, string, string, Span)> = [];
    val ht = headToks.append([blankTok, blankTok]);
    var hidx = 0;
    var inAgg = false;
    var aggFn = "";
    var aggArg = "";
    var aggSpan = Span(0, 0, 1);
    for (headToks) { t ->
        val tk = t.0;
        val tx = t.1;
        val nxt = ht.at(hidx + 1) ?? blankTok;
        hidx = hidx + 1;
        val nextOpens = nxt.0 == "paren" && nxt.1 == "(";
        val consumed = inAgg;
        if (consumed) {
            if (tk == "star") aggArg = "*";
            if (tk == "ident") aggArg = tx;
            val closes = tk == "paren" && tx == ")";
            val strayAgg = tk == "comma"
                || tk == "keyword"
                || tk == "number"
                || tk == "string"
                || tk == "op";
            if (strayAgg)
                q.failAt(
                    t.2,
                    "erika: malformed aggregate '"
                        + aggFn
                        + "': write "
                        + aggFn
                        + "(field), or count(*)",
                );
            if (closes) {
                val isCount = aggFn == "count";
                if (isCount)
                    if (aggArg != "*")
                        q.failAt(aggSpan, "erika: count takes '*': count(*)");
                if (!isCount)
                    if (aggArg == "" || aggArg == "*")
                        q.failAt(
                            aggSpan,
                            "erika: "
                                + aggFn
                                + " takes one field: "
                                + aggFn
                                + "(field)",
                        );
                items = items.append([#("agg", aggFn, aggArg, aggSpan)]);
                inAgg = false;
            }
        }
        if (!consumed) {
            if (tk == "star") star = true;
            if (tk == "ident") {
                if (nextOpens) {
                    val isAggFn = tx == "count"
                        || tx == "sum"
                        || tx == "avg"
                        || tx == "min"
                        || tx == "max";
                    if (!isAggFn)
                        q.failAt(
                            t.2,
                            "erika: unknown aggregate '"
                                + tx
                                + "' (count, sum, avg, min, max)",
                        );
                    aggFn = tx;
                    aggArg = "";
                    aggSpan = t.2;
                    inAgg = true;
                }
                if (!nextOpens) items = items.append([#("field", tx, "", t.2)]);
            }
        }
    }
    if (inAgg)
        q.failAt(aggSpan, "erika: aggregate '" + aggFn + "' is not closed");

    // where clause → `or`-groups of `and`-groups of comparisons (precedence is
    // the nesting: a new `or` closes the current `or`-group, `and` only the
    // current comparison).
    val hasWhere = whereToks.length > 0;
    var orGroups: Array<Array<#(string, string, string, Span, string, string, bool, Span, Span)>> = [];
    var curAnd: Array<#(string, string, string, Span, string, string, bool, Span, Span)> = [];
    var curCmp: Array<#(string, string, Span)> = [];
    for (whereToks) { t ->
        val isAnd = t.0 == "keyword" && t.1 == "and";
        val isOr = t.0 == "keyword" && t.1 == "or";
        val isConn = isAnd || isOr;
        if (isAnd)
            if (curCmp.length > 0) {
                curAnd = curAnd.append([buildCmp(curCmp)]);
                curCmp = [];
            }
        if (isOr) {
            if (curCmp.length > 0) {
                curAnd = curAnd.append([buildCmp(curCmp)]);
                curCmp = [];
            }
            orGroups = orGroups.append([curAnd]);
            curAnd = [];
        }
        if (!isConn) curCmp = curCmp.append([t]);
    }
    if (curCmp.length > 0) curAnd = curAnd.append([buildCmp(curCmp)]);
    if (hasWhere) orGroups = orGroups.append([curAnd]);

    var orderName = "";
    var orderSpan = Span(0, 0, 1);
    var orderDesc = false;
    for (orderToks) { ot ->
        val isAsc = ot.1 == "asc";
        val isDesc = ot.1 == "desc";
        if (isDesc) orderDesc = true;
        val isDir = isAsc || isDesc;
        if (!isDir)
            if (orderName == "") {
                orderName = ot.1;
                orderSpan = ot.2;
            }
    }
    val hasOrder = orderToks.length > 0;

    // limit: one token, a whole number or a hole.
    var limitKind = "";
    var limitText = "";
    var limitSpan = Span(0, 0, 1);
    for (limitToks) { lt ->
        if (limitText != "")
            q.failAt(lt.2, "erika: limit takes one number or one hole");
        val isNum = lt.0 == "number" && !lt.1.contains(".");
        val isHoleLim = isHolePlaceholder(lt.1);
        val okLim = isNum || isHoleLim;
        if (!okLim)
            q.failAt(
                lt.2,
                "erika: limit takes a whole number or a hole, not '"
                    + lt.1
                    + "'",
            );
        limitKind = if (isNum) "number" else "hole";
        limitText = lt.1;
        limitSpan = lt.2;
    }
    val hasLimit = limitText != "";
    if (hasLimit == false)
        if (section == "limit")
            q.failAt(srcSpan, "erika: limit takes a whole number or a hole");

    // ── shape checks ─────────────────────────────────────────────────────────
    val hasJoin = joinName != "";
    val hasGroup = groupName != "";
    val nAgg = items.filter({ i0 -> i0.0 == "agg" }).length;
    val nField = items.filter({ i0 -> i0.0 == "field" }).length;
    val hasAgg = nAgg > 0;
    if (star)
        if (items.length > 0)
            q.failAt(
                srcSpan,
                "erika: '*' cannot be selected beside fields or aggregates",
            );
    if (!star)
        if (items.length == 0)
            q.failAt(srcSpan, "erika: select needs '*', fields or aggregates");
    if (hasGroup)
        if (star)
            q.failAt(
                groupSpan,
                "erika: group by needs fields and aggregates, not '*'",
            );
    for (items) { it0 ->
        val isField = it0.0 == "field";
        if (isField)
            if (hasAgg)
                if (!hasGroup)
                    q.failAt(
                        it0.3,
                        "erika: '"
                            + it0.1
                            + "' beside an aggregate needs group by "
                            + it0.1,
                    );
        if (isField)
            if (hasGroup)
                if (it0.1 != groupName)
                    q.failAt(
                        it0.3,
                        "erika: '"
                            + it0.1
                            + "' is neither the group by field nor an aggregate",
                    );
    }
    if (hasAgg)
        if (!hasGroup) {
            if (hasOrder)
                q.failAt(
                    orderSpan,
                    "erika: order by has nothing to order: an aggregate without group by answers one value",
                );
            if (hasLimit)
                q.failAt(
                    limitSpan,
                    "erika: limit has nothing to cut: an aggregate without group by answers one value",
                );
        }
    if (hasGroup)
        if (hasOrder)
            if (orderName != groupName)
                q.failAt(
                    orderSpan,
                    "erika: with group by, order by names the group by field '"
                        + groupName
                        + "'",
                );
    // join <Name> on <a.f> = <b.g>: exactly three tokens, `=` between two
    // qualified fields, one of each collection.
    var onL = "";
    var onR = "";
    var onSpan = Span(0, 0, 1);
    if (hasJoin) {
        var oi = 0;
        for (onToks) { ot ->
            if (oi == 0) {
                onL = ot.1;
                onSpan = ot.2;
            }
            if (oi == 1)
                if (ot.1 != "=")
                    q.failAt(ot.2, "erika: a join condition is 'a.f = b.g'");
            if (oi == 2) onR = ot.1;
            oi = oi + 1;
        }
        if (oi != 3)
            q.failAt(
                joinSpan,
                "erika: join " + joinName + " needs 'on a.f = b.g'",
            );
    }

    // ── resolve the source + dual lowering (③ code, ④ reference tree) ─────────
    val src = srcName;
    val jn = joinName;
    val known = q.lookup(srcName);
    val joinKnown = if (hasJoin) q.lookup(joinName) else null;
    if (hasJoin)
        if (joinKnown == null)
            q.failAt(
                joinSpan,
                "erika: unknown collection '" + joinName + "' in scope",
            );
    if (known) {
        binding ->
        // A field reads off `rv` (`row`, or the pair `row.0` / `row.1` after a join).
        val fieldCode = { txt, span, rv ->
            val ps = txt.split(".");
            val np = ps.length;
            val qual = ps.at(0) ?? "";
            val fld = ps.at(np - 1) ?? "";
            if (np > 2)
                q.failAt(
                    span,
                    "erika: '" + txt + "' has more than one qualifier",
                );
            if (np == 1)
                if (hasJoin)
                    q.failAt(
                        span,
                        "erika: after a join every field is qualified: "
                            + src
                            + "."
                            + txt
                            + " or "
                            + jn
                            + "."
                            + txt,
                    );
            val isQual = np == 2;
            val okQual = qual == src || qual == jn;
            if (isQual)
                if (!okQual)
                    q.failAt(
                        span,
                        "erika: '"
                            + qual
                            + "' is neither '"
                            + src
                            + "' nor a joined collection",
                    );
            val side = if (qual == jn) "1" else "0";
            val out = if (hasJoin)
                rv + "." + side + "." + fld
            else
                rv + "." + fld;
            out;
        };
        // The collection a field belongs to, as a column: its element type is
        // the type the field is compared against.
        val witnessOf = { txt ->
            val ps = txt.split(".");
            val np = ps.length;
            val qual = ps.at(0) ?? "";
            val fld = ps.at(np - 1) ?? "";
            val coll = if (np == 2) qual else src;
            coll + ".map({ row -> row." + fld + " })";
        };
        val operandCode = { knd, txt, span ->
            val isHole = isHolePlaceholder(txt);
            val out = if (isHole)
                "__h" + holes.indexOf(txt).toString()
            else if (knd == "string")
                "\"" + txt.split("'").join("") + "\""
            else if (knd == "number")
                txt
            else
                fieldCode(txt, span, "row");
            out;
        };
        val opCode = { opText ->
            val out = if (opText == "=")
                "=="
            else if (opText == "<>")
                "!="
            else
                opText;
            out;
        };
        val cmpCode = { cmp ->
            val lc = operandCode(cmp.0, cmp.1, cmp.7);
            val rc = operandCode(cmp.4, cmp.5, cmp.8);
            val oc = opCode(cmp.2);
            val out = if (cmp.6) lc + " " + oc + " " + rc else lc;
            out;
        };
        // ③ the pipeline. `join` pairs every source row with the rows of the
        // joined collection its condition matches (inner): a row is then
        // `#(left, right)`.
        var pipe = "of(" + srcName + ")";
        if (hasJoin) {
            val lq = onL.split(".").at(0) ?? "";
            val rq = onR.split(".").at(0) ?? "";
            val okL = lq == src || lq == jn;
            val okR = rq == src || rq == jn;
            if (!okL)
                q.failAt(
                    onSpan,
                    "erika: '"
                        + lq
                        + "' is neither '"
                        + src
                        + "' nor '"
                        + jn
                        + "'",
                );
            if (!okR)
                q.failAt(
                    onSpan,
                    "erika: '"
                        + rq
                        + "' is neither '"
                        + src
                        + "' nor '"
                        + jn
                        + "'",
                );
            if (lq == rq)
                q.failAt(
                    onSpan,
                    "erika: a join condition compares a field of each collection",
                );
            val lIsSrc = lq == src;
            val lf = onL.split(".").at(1) ?? "";
            val rf = onR.split(".").at(1) ?? "";
            val lKey = if (lIsSrc) "l." + lf else "r." + lf;
            val rKey = if (lIsSrc) "r." + rf else "l." + rf;
            pipe = "of("
                + src
                + ").selectMany({ l -> "
                + jn
                + ".filter({ r -> "
                + lKey
                + " == "
                + rKey
                + " }).map({ r -> #(l, r) }) })";
        }
        if (hasWhere) {
            val orParts = orGroups.map(
                { andGroup -> andGroup.map({ cmp -> cmpCode(cmp) }).join(" && ") },
            );
            pipe = pipe + ".where({ row -> " + orParts.join(" || ") + " })";
        }
        // With group by the rows are ordered by the key BEFORE they are grouped
        // (groups come out in first-seen order, so they come out in key order),
        // and the groups are an array from there on: the operators of a `Query`
        // of groups would be dispatched without their receiver's type.
        if (hasOrder) {
            val opName = if (orderDesc) "orderByDescending" else "orderBy";
            val keyCode = fieldCode(orderName, orderSpan, "row");
            pipe = pipe + "." + opName + "({ row -> " + keyCode + " })";
        }
        if (hasGroup)
            pipe = pipe
                + ".groupBy({ row -> "
                + fieldCode(groupName, groupSpan, "row")
                + " }).toArray()";
        // The number of rows is written in the query (decision 312): `limit 1`
        // answers one row, `?T` (`first()`); any other `limit n` keeps an array
        // and cuts it (`take(n)`); with no `limit` the answer is the array.
        val firstOne = hasLimit && limitKind == "number" && limitText == "1";
        val limitCode = if (limitKind == "hole")
            "__h" + holes.indexOf(limitText).toString()
        else
            limitText;
        // The operators run as plain functions on a query: a method call on a
        // receiver the checker has not typed yet (inside a hole's lambda) is
        // dispatched by name alone on erlang, and `take` / `first` also name an
        // array's own.
        if (hasLimit)
            if (!firstOne)
                if (hasGroup) pipe = pipe + ".take(" + limitCode + ")";
        if (hasLimit)
            if (!firstOne)
                if (!hasGroup)
                    pipe = "queryTake(" + pipe + ", " + limitCode + ")";
        // The aggregate an item names, on a query `qv` of rows.
        val aggOn = { itm, qv, rv ->
            val fnm = itm.1;
            val fld = if (itm.2 == "*") "" else fieldCode(itm.2, itm.3, rv);
            val lam = "{ " + rv + " -> " + fld + " }";
            val out = if (fnm == "count")
                "aggCount(" + qv + ")"
            else if (fnm == "sum")
                "aggSum(" + qv + ", " + lam + ")"
            else if (fnm == "avg")
                "aggAvg(" + qv + ", " + lam + ")"
            else if (fnm == "min")
                "aggMin(" + qv + ", " + lam + ")"
            else
                "aggMax(" + qv + ", " + lam + ")";
            out;
        };
        if (hasAgg)
            if (!hasGroup) {
                // aggregates without group by: one value (a tuple for several)
                val single = items.length == 1;
                if (single)
                    pipe = items.map({ i1 -> aggOn(i1, pipe, "row") }).join("");
                if (!single) {
                    val codes = items.map({ i1 -> aggOn(i1, "qq", "row") });
                    pipe = "bindOnce("
                        + pipe
                        + ", { qq -> #("
                        + codes.join(", ")
                        + ") })";
                }
            }
        if (hasGroup) {
            // one row per group: its key and its aggregates
            val groupItem = { i1 ->
                val out = if (i1.0 == "field")
                    "g.key"
                else
                    aggOn(i1, "groupRows(g)", "row");
                out;
            };
            val sel = if (items.length == 1)
                groupItem(items.at(0) ?? #("", "", "", Span(0, 0, 1)))
            else
                "#(" + items.map({ i1 -> groupItem(i1) }).join(", ") + ")";
            val groupTerminal = if (firstOne) ".at(0)" else "";
            pipe = pipe + ".map({ g -> " + sel + " })" + groupTerminal;
        }
        val plainRows = !hasAgg && !hasGroup;
        val plainEnd = if (firstOne) "" else ".toArray()";
        if (plainRows) {
            if (star) pipe = pipe + plainEnd;
            if (!star) {
                val single = items.length == 1;
                if (single) {
                    val one = items
                        .map({ i1 -> fieldCode(i1.1, i1.3, "row") })
                        .join("");
                    pipe = pipe + ".select({ row -> " + one + " })" + plainEnd;
                }
                if (!single) {
                    // plain fields of one collection are labeled by their names
                    // (`val #(a, b) = r`); after a join the tuple is positional.
                    val binds = if (hasJoin)
                        ""
                    else
                        items
                            .map(
                                { i1 -> "val " + i1.1 + " = row." + i1.1 + "; " },
                            )
                            .join("");
                    val parts = if (hasJoin)
                        items
                            .map({ i1 -> fieldCode(i1.1, i1.3, "row") })
                            .join(", ")
                    else
                        items.map({ i1 -> i1.1 }).join(", ");
                    pipe = pipe
                        + ".select({ row -> "
                        + binds
                        + "#("
                        + parts
                        + ") })"
                        + plainEnd;
                }
            }
            if (firstOne) pipe = "queryFirst(" + pipe + ")";
        }
        // Each hole meets a column, a literal or an earlier hole: its witness
        // (`holeBound`'s first argument) shares one type with it, so a mismatch is
        // the ordinary type error ranged at the hole's own expression. A hole's
        // first witness rides in `holeBound`; the others are `holeTie`s ahead of
        // the pipeline. The number of rows is a whole number.
        var ties: Array<#(i32, string)> = [];
        for (orGroups) { andGroup ->
            for (andGroup) { cmp ->
                val lh = isHolePlaceholder(cmp.1);
                val rh = isHolePlaceholder(cmp.5);
                val anyH = lh || rh;
                val li = holes.indexOf(cmp.1);
                val ri = holes.indexOf(cmp.5);
                val bothH = lh && rh;
                val sameH = bothH && li == ri;
                if (cmp.6)
                    if (anyH)
                        if (!sameH) {
                            val hi0 = if (lh) li else ri;
                            val oKind = if (lh) cmp.4 else cmp.0;
                            val oText = if (lh) cmp.5 else cmp.1;
                            val oSpan = if (lh) cmp.8 else cmp.7;
                            val later = if (bothH) {
                                if (li > ri) li else ri;
                            } else hi0;
                            val earlier = if (bothH) {
                                if (li > ri) ri else li;
                            } else 0;
                            val witness = if (bothH)
                                "[__h" + earlier.toString() + "]"
                            else if (oKind == "ident")
                                witnessOf(oText)
                            else
                                "[" + operandCode(oKind, oText, oSpan) + "]";
                            ties = ties.append([#(later, witness)]);
                        }
            }
        }
        if (limitKind == "hole")
            ties = ties.append([#(holes.indexOf(limitText), "[0]")]);
        // Each hole is evaluated once, before the pipeline runs, in the order
        // the query writes them (the first hole outermost).
        var tieVals = "";
        var ti = 0;
        for (holes) { hq ->
            val mine = ties.filter({ tt -> tt.0 == ti });
            var k = 0;
            for (mine) { mt ->
                if (k > 0)
                    tieVals = tieVals
                        + "val __t"
                        + ti.toString()
                        + "_"
                        + k.toString()
                        + " = holeTie("
                        + mt.1
                        + ", __h"
                        + ti.toString()
                        + "); ";
                k = k + 1;
            }
            ti = ti + 1;
        }
        var held = tieVals + pipe;
        var hi = holes.length;
        for (holes) { hp ->
            hi = hi - 1;
            val mine = ties.filter({ tt -> tt.0 == hi });
            var firstWit = "";
            for (mine) { mw ->
                if (firstWit == "") firstWit = mw.1;
            }
            val head = if (firstWit != "")
                "holeBound(" + firstWit + ", "
            else
                "bindOnce(";
            held = head
                + holes.at(hi)
                + ", { __h"
                + hi.toString()
                + " -> "
                + held
                + " })";
        }
        pipe = held;
        // ④ the reference tree
        var nodes: Array<CustomNode> = [];
        for (toks) { t ->
            val tk = t.0;
            val tx = t.1;
            val isLogical = tk == "keyword" && (tx == "and" || tx == "or");
            val isPlainKw = tk == "keyword" && !isLogical;
            val lbl = if (isPlainKw)
                "keyword"
            else if (isLogical)
                "operator"
            else if (tk == "ident")
                "property"
            else if (tk == "string")
                "string"
            else if (tk == "number")
                "number"
            else if (tk == "op")
                "operator"
            else if (tk == "star")
                "operator"
            else
                "none";
            val skip = tk == "comma" || tk == "paren";
            val isSrc = t.2.start == srcSpan.start && t.2.end == srcSpan.end;
            val isJoinSrc = hasJoin
                && t.2.start == joinSpan.start
                && t.2.end == joinSpan.end;
            if (isSrc)
                nodes = nodes.append(
                    [
                        CustomNode(
                            kind: tk,
                            span: t.2,
                            label: lbl,
                            ref: binding,
                            children: [],
                        ),
                    ],
                );
            if (isJoinSrc)
                nodes = nodes.append(
                    [
                        CustomNode(
                            kind: tk,
                            span: t.2,
                            label: lbl,
                            ref: joinKnown,
                            children: [],
                        ),
                    ],
                );
            val plain = !skip && !isSrc && !isJoinSrc;
            if (plain)
                nodes = nodes.append(
                    [
                        CustomNode(
                            kind: tk,
                            span: t.2,
                            label: lbl,
                            ref: null,
                            children: [],
                        ),
                    ],
                );
        }
        val root = CustomNode(
            kind: "query",
            span: Span(0, sqlLen, 1),
            label: "none",
            ref: null,
            children: nodes,
        );
        return q.custom(root, q.build(pipe));
    }
    // Unknown collection → a diagnostic ranged at the offending name *inside* the
    // string (sublanguage-lsp F2), not at the whole template.
    return q.failAt(
        srcSpan,
        "erika: unknown collection '" + srcName + "' in scope",
    );
}

// ── tests: fluent layer ─────────────────────────────────────────────────────

test "erika of/range/repeat/empty construct" {
    assert of([1, 2, 3]).count() == 3;
    assert range(1, 5).toArray().join(",") == "1,2,3,4";
    assert repeat("x", 3).toArray().join(",") == "x,x,x";
    assert empty().isEmpty();
}

test "erika where/select pipeline materializes" {
    val out = of([1, 2, 3, 4, 5])
        .where({ n -> n % 2 == 0 })
        .select({ n -> n * 10 })
        .toArray();
    assert out.join(",") == "20,40";
}

test "erika selectMany flattens per-item arrays" {
    val out = of([1, 2, 3]).selectMany({ n -> [n, n * 10] }).toArray();
    assert out.join(",") == "1,10,2,20,3,30";
}

test "erika range where even sum is 2550" {
    val total = range(1, 101).where({ n -> n % 2 == 0 }).sum({ n -> n });
    assert total == 2550;
}

test "erika take/skip/takeWhile/skipWhile/reverse" {
    assert of([1, 2, 3, 4]).take(2).toArray().join(",") == "1,2";
    assert of([1, 2, 3, 4]).skip(2).toArray().join(",") == "3,4";
    assert of([1, 2, 3, 1]).takeWhile({ n -> n < 3 }).toArray().join(",")
        == "1,2";
    assert of([1, 2, 3, 1]).skipWhile({ n -> n < 3 }).toArray().join(",")
        == "3,1";
    assert of([1, 2, 3]).reverse().toArray().join(",") == "3,2,1";
}

test "erika orderBy ascending and descending are stable" {
    val asc = of([3, 1, 2, 1]).orderBy({ n -> n }).toArray();
    assert asc.join(",") == "1,1,2,3";
    val desc = of([3, 1, 2]).orderByDescending({ n -> n }).toArray();
    assert desc.join(",") == "3,2,1";
}

test "erika orderBy by string key" {
    val out = of(["banana", "apple", "cherry"]).orderBy({ s -> s }).toArray();
    assert out.join(",") == "apple,banana,cherry";
}

test "erika distinct removes structural duplicates" {
    assert of([1, 2, 2, 3, 1]).distinct().count() == 3;
    assert of(["a", "a", "b"]).distinctBy({ s -> s }).count() == 2;
}

test "erika concat/union/intersect/except" {
    assert of([1, 2]).concat(of([3, 4])).toArray().join(",") == "1,2,3,4";
    assert of([1, 2, 3]).union(of([2, 3, 4])).count() == 4;
    assert of([1, 2, 3]).intersect(of([2, 3, 4])).toArray().join(",") == "2,3";
    assert of([1, 2, 3]).except(of([2, 3, 4])).toArray().join(",") == "1";
}

test "erika groupBy partitions by key" {
    val groups = of([1, 2, 3, 4, 5, 6]).groupBy({ n -> n % 2 }).toArray();
    assert groups.length == 2;
    val odds = of(groups).firstWhere({ g -> g.key == 1 }) ?? Grouping(
        key: -1,
        items: [],
    );
    assert odds.count() == 3;
    assert odds.toArray().join(",") == "1,3,5";
}

test "erika zip combines pairwise to shorter length" {
    val out = of([1, 2, 3]).zip(of([10, 20]), { a, b -> a + b }).toArray();
    assert out.join(",") == "11,22";
}

test "erika aggregate folds left like Array.fold" {
    val total = of([1, 2, 3, 4]).aggregate(0, { acc, n -> acc + n });
    assert total == 10;
    val cat = of(["a", "b", "c"]).aggregate("", { acc, s -> acc + s });
    assert cat == "abc";
}

test "erika sum/average/min/max" {
    assert of([1, 2, 3, 4]).sum({ n -> n }) == 10;
    assert of([2.0, 4.0, 6.0]).average({ n -> n }) == 4.0;
    assert of([3, 1, 2]).min({ n -> n }) ?? -1 == 1;
    assert of([3, 1, 2]).max({ n -> n }) ?? -1 == 3;
}

test "erika first/firstWhere/last/single/elementAt return optionals" {
    assert of([10, 20, 30]).first() ?? -1 == 10;
    assert of([10, 20, 30]).firstWhere({ n -> n > 15 }) ?? -1 == 20;
    assert of([10, 20, 30]).last() ?? -1 == 30;
    assert of([42]).single() ?? -1 == 42;
    assert of([1, 2]).single() ?? -99 == -99;
    assert of([10, 20, 30]).elementAt(1) ?? -1 == 20;
}

test "erika first on no match returns absent" {
    assert of([1, 2, 3]).firstWhere({ n -> n > 9 }) ?? -1 == -1;
}

test "erika any/anyWhere/all/contains quantifiers" {
    assert of([1, 2, 3]).any();
    assert !empty().any();
    assert of([1, 2, 3]).anyWhere({ n -> n > 2 });
    assert of([2, 4, 6]).all({ n -> n % 2 == 0 });
    assert of([1, 2, 3]).contains(2);
    assert !of([1, 2, 3]).contains(9);
}

// ── tests: the `erika "…"` template (expanded in-file) ───────────────────────
// The query string resolves its collection against this module's top-level
// scope snapshot, so the fixture below is a top-level `val`.

type ErikaCity(
    name: string,
    pop: i32,
)

val erikaCities = [
    ErikaCity(name: "Lyon", pop: 5),
    ErikaCity(name: "Paris", pop: 9),
    ErikaCity(name: "Nice", pop: 3),
];

test "erika query: select * returns the whole collection" {
    val all = erika "select * from erikaCities";
    assert all.length == 3;
}

test "erika query: where filters, order by sorts, select projects a field" {
    val names = erika "select name from erikaCities where pop >= 5 order by name asc";
    assert names.join(",") == "Lyon,Paris";
}

test "erika query: order by desc reverses" {
    val desc = erika "select name from erikaCities order by pop desc";
    assert desc.join(",") == "Paris,Lyon,Nice";
}

test "erika query: where with a string literal" {
    val one = erika "select pop from erikaCities where name = 'Paris'";
    assert one.join(",") == "9";
}

test "erika query: multi-field select projects a tuple per row" {
    val rows = erika "select name, pop from erikaCities where pop >= 5 order by name asc";
    val labels = rows.map({ r ->
        val #(name, pop) = r;
        name + ":" + pop.toString();
    });
    assert labels.join(",") == "Lyon:5,Paris:9";
}

test "erika query: triple-quoted multi-line form tokenizes the same" {
    val names = erika """
        select name from erikaCities
        where pop >= 5
        order by name asc
    """;
    assert names.join(",") == "Lyon,Paris";
}

test "erika query: where with and narrows both predicates" {
    val mid = erika "select name from erikaCities where pop >= 5 and pop <= 9 order by name asc";
    assert mid.join(",") == "Lyon,Paris";
}

test "erika query: where with or unions predicates" {
    val some = erika "select name from erikaCities where pop <= 3 or pop >= 9 order by name asc";
    assert some.join(",") == "Nice,Paris";
}

// `or < and < comparison`: this parses as `pop >= 9 || (pop >= 5 && name = 'Lyon')`,
// so Paris (pop 9) and Lyon (pop 5, name match) qualify but Nice does not. Were the
// precedence flipped to `(a || b) && c` only Lyon would survive — the assertion below
// pins the structural `or`-of-`and` lowering.
test "erika query: where precedence is or over and over comparison" {
    val rows = erika "select name from erikaCities where pop >= 9 or pop >= 5 and name = 'Lyon'";
    assert rows.join(",") == "Lyon,Paris";
}

test "erika query: not-equal operator <> maps to !=" {
    val notLyon = erika "select name from erikaCities where name <> 'Lyon' order by name asc";
    assert notLyon.join(",") == "Nice,Paris";
}

// §G1 — `${expr}` interpolations inside the SQL string become runtime operands
// (the lex/parse stage threads each hole's placeholder identifier through as if
// it were an ordinary token; `operandCode` emits it verbatim, so the host's
// `substituteHoles` pass swaps in the caller's expression after `q.build(…)`).
test "erika query: ${} interp inlines a runtime value as the right-hand operand" {
    val threshold = 5;
    val names = erika "select name from erikaCities where pop >= ${threshold} order by name asc";
    assert names.join(",") == "Lyon,Paris";
}

test "erika query: ${} interp inlines a runtime value on both sides" {
    val limit = 9;
    val ge = 5;
    val mid = erika "select name from erikaCities where pop >= ${ge} and pop <= ${limit} order by name asc";
    assert mid.join(",") == "Lyon,Paris";
}

test "erika query: a hole is any expression" {
    val next = { -> 5 };
    val names = erika "select name from erikaCities where pop >= ${next()} order by name asc";
    assert names.join(",") == "Lyon,Paris";
    val base = 2;
    val plus = erika "select name from erikaCities where pop > ${base * 2
        + 1} order by name asc";
    assert plus.join(",") == "Paris";
}

test "erika query: a hole on the left, a string hole, holes in or and and" {
    val pivot = 5;
    val left = erika "select name from erikaCities where ${pivot} <= pop order by name asc";
    assert left.join(",") == "Lyon,Paris";
    val who = "Nice";
    val one = erika "select pop from erikaCities where name = ${who}";
    assert one.join(",") == "3";
    val lo = 3;
    val hi = 9;
    val ends = erika "select name from erikaCities where pop = ${lo} or pop = ${hi} order by name asc";
    assert ends.join(",") == "Nice,Paris";
}

fn erikaAdults(minAge: i32) -> Array<string> {
    return erika "select name from erikaCities where pop >= ${minAge} order by name asc";
}

test "erika query: a hole reads a parameter" {
    assert erikaAdults(5).join(",") == "Lyon,Paris";
    assert erikaAdults(9).join(",") == "Paris";
}

// ── tests: select over `var listas = [..]` ───────────────────────────────────
// The fluent layer is an ordinary runtime call, so it queries ANY in-scope array
// — `val` or `var`, records or scalars, even after the `var` is reassigned. (The
// `erika "…"` template, by contrast, resolves its collection from the caller's
// *comptime* scope snapshot, which only captures immutable `val` bindings, so the
// SQL form needs a `val` collection — see AGENTS.md.)

type ErikaProduct(
    nome: string,
    preco: i32,
)

test "erika select over a var listas of records" {
    var listas = [
        ErikaProduct(nome: "caderno", preco: 12),
        ErikaProduct(nome: "caneta", preco: 3),
        ErikaProduct(nome: "mochila", preco: 80),
    ];
    // select the names of the pricier items
    val caros = of(listas)
        .where({ p -> p.preco >= 12 })
        .select({ p -> p.nome })
        .toArray();
    assert caros.join(",") == "caderno,mochila";

    // a `var` can be reassigned and re-queried
    listas = listas.append([ErikaProduct(nome: "lapis", preco: 2)]);
    val baratos = of(listas)
        .where({ p -> p.preco < 12 })
        .orderBy({ p -> p.preco })
        .select({ p -> p.nome })
        .toArray();
    assert baratos.join(",") == "lapis,caneta";
}

test "erika select over a var listas of scalars" {
    var listas = [1, 2, 3, 4, 5, 6];
    val paresPorDez = of(listas)
        .where({ n -> n % 2 == 0 })
        .select({ n -> n * 10 })
        .toArray();
    assert paresPorDez.join(",") == "20,40,60";
}

test "erika multi-field select over a var listas" {
    var listas = [
        ErikaProduct(nome: "caderno", preco: 12),
        ErikaProduct(nome: "caneta", preco: 3),
    ];
    // project two columns into a tuple per row (the same shape the
    // `erika "select nome, preco …"` SQL form expands to)
    val pares = of(listas)
        .select({ p ->
            val nome = p.nome;
            val preco = p.preco;
            #(nome, preco);
        })
        .toArray();
    assert pares
        .map({ x ->
            val #(nome, preco) = x;
            nome + ":" + preco.toString();
        })
        .join(",")
        == "caderno:12,caneta:3";
}
